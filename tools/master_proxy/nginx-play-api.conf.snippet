# Paste inside the HTTPS server{} that serves /play/ (see tools/nginx-cod2-web.conf).
# Proxies browser masterlist requests to tools/master_proxy/server.py on :20711.
#
#   location /play/api/masterlist/cod2/1.3
#     → http://127.0.0.1:20711/masterlist/cod2/1.3
#     → https://api.cod.pm/masterlist/cod2/1.3

location /play/api/ {
    proxy_pass http://127.0.0.1:20711/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;

    # Match /play/ COOP/COEP so crossOriginIsolated pages can fetch same-origin.
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "require-corp" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Cache-Control "no-cache" always;
}
